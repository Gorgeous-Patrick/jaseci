digraph TensorGraph {
rankdir=LR;
"signal" [label="signal\nInput\n[]"];
"x" [label="x\nInput\n[2, 2]"];
"weight" [label="weight\nParameter\n[2, 2]"];
"zero" [label="zero\nConstant\n[]"];
"condition_dependency" [label="condition_dependency\nSquare\n[]"];
"predicate" [label="predicate\nGreater\n[]"];
"condition_value" [label="condition_value\nAdd\n[]"];
"common" [label="common\nMatMul\n[2, 2]"];
"common_fanout" [label="common_fanout\nSquare\n[2, 2]"];
"true" [label="true\nAdd\n[2, 2]"];
"false" [label="false\nSubtract\n[2, 2]"];
"choose" [label="choose\nCond\n[2, 2]"];
"output" [label="output\nAdd\n[2, 2]"];
"signal" -> "condition_dependency" [label="x"];
"signal" -> "condition_value" [label="b"];
"x" -> "common" [label="a"];
"weight" -> "common" [label="b"];
"zero" -> "predicate" [label="b"];
"zero" -> "output" [label="b"];
"condition_dependency" -> "condition_value" [label="a"];
"predicate" -> "choose" [label="condition"];
"condition_value" -> "predicate" [label="a"];
"condition_value" -> "true" [label="b"];
"condition_value" -> "false" [label="b"];
"common" -> "common_fanout" [label="x"];
"common" -> "true" [label="a"];
"common_fanout" -> "false" [label="a"];
"true" -> "choose" [label="true_result"];
"false" -> "choose" [label="false_result"];
"choose" -> "output" [label="a"];
}
