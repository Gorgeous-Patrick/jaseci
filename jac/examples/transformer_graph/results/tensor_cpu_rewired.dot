digraph Transformer {
  rankdir=LR;
  "model" [shape=diamond,label="Model / Infer entry"];
  "model" -> "source" [label="seed:entry"];
  "model" -> "target" [label="seed:entry"];
  "source" [label="source\nInput"];
  "source" -> "enc_embed" [label="main:x"];
  "target" [label="target\nInput"];
  "target" -> "dec_embed" [label="main:x"];
  "enc_embed" [label="enc_embed\nEmbedding"];
  "enc_embed" -> "enc_pos" [label="main:x"];
  "enc_pos" [label="enc_pos\nPositionalEncoding"];
  "enc_pos" -> "enc_attn" [label="main:x"];
  "enc_attn" [label="enc_attn\nSelfAttention"];
  "enc_attn" -> "enc_norm1" [label="main:main"];
  "enc_attn" -> "enc_norm1" [label="residual:skip"];
  "enc_norm1" [label="enc_norm1\nAddNorm"];
  "enc_norm1" -> "enc_ffn" [label="main:x"];
  "enc_norm1" -> "enc_norm2" [label="residual:skip"];
  "enc_ffn" [label="enc_ffn\nFeedForward"];
  "enc_ffn" -> "enc_norm2" [label="main:main"];
  "enc_norm2" [label="enc_norm2\nAddNorm"];
  "enc_norm2" -> "cross_attn" [label="encoder_memory:memory"];
  "dec_embed" [label="dec_embed\nEmbedding"];
  "dec_embed" -> "dec_pos" [label="main:x"];
  "dec_pos" [label="dec_pos\nPositionalEncoding"];
  "dec_pos" -> "dec_attn" [label="main:x"];
  "dec_pos" -> "dec_norm1" [label="residual:skip"];
  "dec_attn" [label="dec_attn\nCausalSelfAttention"];
  "dec_attn" -> "dec_norm1" [label="main:main"];
  "dec_norm1" [label="dec_norm1\nAddNorm"];
  "dec_norm1" -> "cross_attn" [label="main:x"];
  "dec_norm1" -> "dec_norm2" [label="residual:skip"];
  "cross_attn" [label="cross_attn\nCrossAttention"];
  "cross_attn" -> "dec_norm2" [label="main:main"];
  "dec_norm2" [label="dec_norm2\nAddNorm"];
  "dec_norm2" -> "dec_ffn" [label="main:x"];
  "dec_norm2" -> "dec_norm3" [label="residual:skip"];
  "dec_ffn" [label="dec_ffn\nFeedForward"];
  "dec_ffn" -> "dec_norm3" [label="main:main"];
  "dec_norm3" [label="dec_norm3\nAddNorm"];
  "dec_norm3" -> "projection" [label="main:x"];
  "projection" [label="projection\nLinear"];
  "projection" -> "probabilities" [label="main:x"];
  "probabilities" [label="probabilities\nSoftmax"];
}
